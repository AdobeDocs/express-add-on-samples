# HTTP port for Express. Forward this port to an HTTPS URL for local add-on dev (see ../README.md).
PORT=3001
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
CORS_ORIGINS=https://localhost:5241,https://new.express.adobe.com # You will get a dedicated cors origin for your add-on when you will create private link or publish your add-on which look like this `https://abc123.wxp.adobe-addons.com`.
