# HTTP port for Express. Forward this port to an HTTPS URL for local add-on dev (see ../README.md).
PORT=3001
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
# Browser Origin from the add-on panel (https://localhost:5241 locally).
CORS_ORIGINS=https://localhost:5241,https://new.express.adobe.com
